# ==============================================================================
# Sentinel RFP Agent - Environment Variables
# ==============================================================================
# Copy this file to '.env' and customize for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
# Set to 'production' for release builds. 'development' enables extra logging.
ENV=development

# ------------------------------------------------------------------------------
# 2. AI Provider (Google Gemini cloud-first, or local Ollama)
# ------------------------------------------------------------------------------
# 'google' (default, cloud) or 'ollama' (local).
LLM_PROVIDER=google

# Google AI Studio API key. Required when LLM_PROVIDER=google.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Default Gemini generation model (free-tier friendly)
GOOGLE_LLM_MODEL=gemini-flash-latest

# Default Gemini embedding model (used by RAG when provider is google)
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# Ollama service URL (used when LLM_PROVIDER=ollama; default: localhost:11434)
OLLAMA_URL=http://localhost:11434

# Default Ollama LLM model for RAG and gap analysis
OLLAMA_MODEL=gemma3:4b

# ------------------------------------------------------------------------------
# 3. Application Database
# ------------------------------------------------------------------------------
# SQLite database path (relative to app data directory)
DATABASE_URL=sqlite:sentinel.db
